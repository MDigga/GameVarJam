from pathlib import Path

file = Path("main.tscn")

text = file.read_text(encoding="utf-8")

# Conflict 1: keep your TileSet resources + add the upstream Portal resource
old = """<<<<<<< HEAD
[ext_resource type="Texture2D" uid="uid://bkyrbg7tsalv" path="res://assets/images/Tiles/Water_Middle.png" id="2_sugp2"]
[ext_resource type="Texture2D" uid="uid://gq0ym52tjhnw" path="res://assets/images/Tiles/Grass_Middle.png" id="3_jyhfs"]

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_tbgi4"]
texture = ExtResource("2_sugp2")
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_tefeu"]
texture = ExtResource("3_jyhfs")
0:0/0 = 0

[sub_resource type="TileSet" id="TileSet_3jhfk"]
tile_size = Vector2i(15, 16)
sources/0 = SubResource("TileSetAtlasSource_tbgi4")
sources/1 = SubResource("TileSetAtlasSource_tefeu")
=======
[ext_resource type="PackedScene" uid="uid://dyqjbql4v2s72" path="res://scenes/Levels/portal.tscn" id="3_sugp2"]
>>>>>>> upstream"""

new = """[ext_resource type="Texture2D" uid="uid://bkyrbg7tsalv" path="res://assets/images/Tiles/Water_Middle.png" id="2_sugp2"]
[ext_resource type="Texture2D" uid="uid://gq0ym52tjhnw" path="res://assets/images/Tiles/Grass_Middle.png" id="3_jyhfs"]
[ext_resource type="PackedScene" uid="uid://dyqjbql4v2s72" path="res://scenes/Levels/portal.tscn" id="3_sugp2"]

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_tbgi4"]
texture = ExtResource("2_sugp2")
0:0/0 = 0

[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_tefeu"]
texture = ExtResource("3_jyhfs")
0:0/0 = 0

[sub_resource type="TileSet" id="TileSet_3jhfk"]
tile_size = Vector2i(15, 16)
sources/0 = SubResource("TileSetAtlasSource_tbgi4")
sources/1 = SubResource("TileSetAtlasSource_tefeu")"""

text = text.replace(old, new)

# Conflict 2: keep your entire TileMap and add upstream's LevelRoot
old = """=======
[node name="LevelRoot" parent="." unique_id=1498280060 instance=ExtResource("1_0wfyh")]
position = Vector2(234, 95)
>>>>>>> upstream"""

new = """[node name="LevelRoot" parent="." unique_id=1498280060 instance=ExtResource("1_0wfyh")]
position = Vector2(234, 95)"""

text = text.replace(old, new)

# Conflict 3: add upstream's Portal
old = """<<<<<<< HEAD
=======

[node name="Portal" parent="." unique_id=705338408 instance=ExtResource("3_sugp2")]
position = Vector2(505, 120)
>>>>>>> upstream"""

new = """[node name="Portal" parent="." unique_id=705338408 instance=ExtResource("3_sugp2")]
position = Vector2(505, 120)"""

text = text.replace(old, new)

# Safety check: there must be no conflict markers left
if "<<<<<<< HEAD" in text or "=======" in text or ">>>>>>> upstream" in text:
    print("ERROR: Conflict markers still remain!")
else:
    file.write_text(text, encoding="utf-8")
    print("SUCCESS! Merge conflict resolved.")
